# --- PostgreSQL ---
POSTGRES_USER=flightpulse
POSTGRES_PASSWORD=flightpulse
POSTGRES_DB=flightpulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flightpulse:flightpulse@localhost:5432/flightpulse

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Phase 4: async job queue (arq, Python-native, Redis-backed) ---
QUEUE_NAME=flightpulse:telemetry
ARQ_MAX_JOB_ATTEMPTS=5
ARQ_RETRY_BACKOFF_BASE_SECONDS=2
ARQ_RETRY_BACKOFF_MAX_SECONDS=60
ARQ_JOB_TIMEOUT_SECONDS=30
DEAD_LETTER_KEY=flightpulse:telemetry:dead_letter
WORKER_CONCURRENCY=2

# --- OpenSky Network API ---
# The official docs recommend OAuth2 client-credentials for programmatic access.
# https://openskynetwork.github.io/opensky-api/rest.html
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_API_BASE_URL=https://opensky-network.org/api

# --- FastAPI ingestion service ---
INGESTION_HOST=0.0.0.0
INGESTION_PORT=8001

# --- Collector (Phase 2) ---
# Conservative polling per OpenSky's documented rate limits.
POLL_INTERVAL_SECONDS=30
COLLECTOR_ID=collector-1
# Where the collector sends normalized batches. Now that the load balancer
# (Phase 3) exists, this points at the load balancer, not at any single
# FastAPI instance directly.
TELEMETRY_TARGET_URL=http://localhost:8080/telemetry

# --- Load balancer (Phase 3) ---
LOAD_BALANCER_HOST=0.0.0.0
LOAD_BALANCER_PORT=8080
# Comma-separated FastAPI ingestion instances the balancer round-robins across.
BACKEND_URLS=http://localhost:8001,http://localhost:8002,http://localhost:8003
LB_FORWARD_TIMEOUT_SECONDS=10
