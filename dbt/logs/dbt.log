    ingestion_id,
    icao24,
    last_contact_at,
    processed_at,
    telemetry_age_seconds
from "flightpulse"."public_intermediate"."int_aircraft_activity"
where telemetry_age_seconds < 0
      
    ) dbt_internal_test
