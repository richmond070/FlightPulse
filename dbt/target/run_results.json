r)", "execution_time": 3.933504343032837, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.flightpulse.unique_stg_opensky_states_ingestion_id.a4599fc31e", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    ingestion_id as unique_field,\n    count(*) as n_records\n\nfrom \"flightpulse\".\"public_staging\".\"stg_opensky_states\"\nwhere ingestion_id is not null\ngroup by ingestion_id\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-29T21:55:48.413965Z", "completed_at": "2026-08-29T21:55:48.445211Z"}, {"name": "execute", "started_at": "2026-08-29T21:55:48.460832Z", "completed_at": "2026-08-29T21:55:52.346040Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 3.955698013305664, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.flightpulse.unique_int_aircraft_activity_ingestion_id.823f8d3e04", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    ingestion_id as unique_field,\n    count(*) as n_records\n\nfrom \"flightpulse\".\"public_intermediate\".\"int_aircraft_activity\"\nwhere ingestion_id is not null\ngroup by ingestion_id\nhaving count(*) > 1\n\n\n", "relation_name": null}], "elapsed_time": 63.28547143936157, "args": {"profiles_dir": ".", "enable_legacy_logger": false, "log_level": "info", "exclude": [], "log_format": "default", "defer": false, "use_colors_file": true, "populate_cache": true, "quiet": false, "cache_selected_only": false, "static_parser": true, "log_level_file": "debug", "strict_mode": false, "indirect_selection": "eager", "source_freshness_run_project_hooks": false, "send_anonymous_usage_stats": true, "project_dir": ".", "print": true, "require_explicit_package_overrides_for_builtin_materializations": true, "require_resource_names_without_spaces": false, "partial_parse": true,